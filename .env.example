# Cerebras – krävs för --provider cerebras. Loggas aldrig och sparas aldrig i dataset.
CEREBRAS_API_KEY=csk-your-key-here

# Valfria körningsinställningar (CLI-flaggor överrider dessa).
CONTRACTFORGE_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CONTRACTFORGE_TIMEOUT_S=180
CONTRACTFORGE_MAX_RETRIES=4
CONTRACTFORGE_BACKOFF_S=1.5
CONTRACTFORGE_CONCURRENCY=4
CONTRACTFORGE_TEMPERATURE=0.7
CONTRACTFORGE_MAX_TOKENS=4000
CONTRACTFORGE_MAX_REPAIRS=2
# CONTRACTFORGE_SEED=42

# Explicit prisuppgift – utan den rapporteras ingen kostnad.
# CONTRACTFORGE_PRICING=./pricing.json
